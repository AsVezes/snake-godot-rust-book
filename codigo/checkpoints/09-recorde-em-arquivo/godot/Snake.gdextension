[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.4
reloadable = false

[libraries]
linux.debug.x86_64 = "res://../rust/target/debug/librenda_snake_step9.so"
linux.release.x86_64 = "res://../rust/target/release/librenda_snake_step9.so"
windows.debug.x86_64 = "res://../rust/target/debug/renda_snake_step9.dll"
windows.release.x86_64 = "res://../rust/target/release/renda_snake_step9.dll"
macos.debug = "res://../rust/target/debug/librenda_snake_step9.dylib"
macos.release = "res://../rust/target/release/librenda_snake_step9.dylib"
